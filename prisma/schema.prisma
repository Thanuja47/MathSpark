datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id              String               @id @default(uuid())
  name            String
  phone           String               @unique
  passwordHash    String
  grade           Int
  medium          String               @default("sinhala")
  role            String               @default("student")
  phoneVerified   Boolean              @default(false)
  enrolledCourses String               @default("[]")
  createdAt       DateTime             @default(now())
  isActive        Boolean              @default(true)
  gradeAccess     StudentGradeAccess[]
}

model StudentGradeAccess {
  id        String    @id @default(uuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradeId   Int
  month     String?   // e.g. "2026-08" — null = legacy all-months access for that grade
  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  @@unique([studentId, gradeId, month])
}

model CourseLesson {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int      @default(0)
  title       String
  description String?
  month       String?  // e.g. "2026-08"
  pdfUrl      String?
  videoUrl    String?
  createdAt   DateTime @default(now())
}

model Tracking {
  id        String   @id
  student   String
  phone     String
  item      String
  status    String
  courier   String
  updatedAt DateTime @updatedAt
}

model Course {
  id             String         @id @default(uuid())
  title          String
  grade          Int
  medium         String
  month          String?
  price          Float
  badge          String?
  description    String
  imageUrl       String?
  sampleVideoUrl String?
  createdAt      DateTime       @default(now())
  lessons        CourseLesson[]
}

model Timetable {
  id        String   @id @default(uuid())
  day       String
  time      String
  subject   String
  grade     Int
  month     String?  // e.g. "2026-08"
  liveLink  String?
  createdAt DateTime @default(now())
}

model Exam {
  id        String   @id @default(uuid())
  title     String
  grade     Int
  month     String?  // e.g. "2026-08"
  duration  Int
  questions String
  createdAt DateTime @default(now())
}

model StoreItem {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  imageUrl    String?
  stock       Int
  createdAt   DateTime @default(now())
  orders      Order[]
}

model Result {
  id          String   @id @default(uuid())
  studentName String
  grade       Int
  subject     String
  score       Int
  year        Int
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model Grade {
  id          String  @id @default(uuid())
  name        String
  description String?
}

model Order {
  id          String    @id @default(uuid())
  studentName String
  phone       String
  storeItemId String?
  storeItem   StoreItem? @relation(fields: [storeItemId], references: [id], onDelete: SetNull)
  itemName    String
  quantity    Int       @default(1)
  totalPrice  Float
  status      String    @default("Pending")
  createdAt   DateTime  @default(now())
}

